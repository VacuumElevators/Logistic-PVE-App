# PVE Logistics Portal — environment variables
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# git-ignored and must never be committed.

# --- Supabase (required) ---
# From the Supabase dashboard: Project Settings → API.

# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key (Settings → API → Project API keys → anon public).
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (Settings → API → Project API keys → service_role).
# SERVER ONLY. Grants full database access and bypasses Row Level Security.
# Never expose this to the browser and never log it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email / SMTP (optional) ---
# If left blank, outgoing notification emails are written to the server log
# instead of being sent. Configure these to send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PVE Logistics Portal <no-reply@example.com>"
